{
    "$schema":  "node_modules/wrangler/config-schema.json",
    "name":  "aurumsentinel-mvp",
    "compatibility_date":  "2026-10-27",
    "assets":  {
                   "directory":  "./dist",
                   "not_found_handling":  "single-page-application",
                   "binding":  "ASSETS",
                   "run_worker_first":  [
                                            "/api/*"
                                        ]
               },
    "main":  "server/worker.mjs"
}